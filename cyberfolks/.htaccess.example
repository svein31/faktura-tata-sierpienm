# Ten plik jest wzorem. Skopiuj go jako .htaccess do public_html subdomeny
# dopiero wtedy, gdy panel nie oferuje mapowania domeny do aplikacji Node.js.
# Zastąp __PANEL_PORT__ portem przydzielonym przez panel cyber_Folks.

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Nie serwuj plików aplikacji z public_html.
  RewriteRule ^$ http://127.0.0.1:__PANEL_PORT__/ [P,L,QSA]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.*)$ http://127.0.0.1:__PANEL_PORT__/$1 [P,L,QSA]
</IfModule>

<FilesMatch "\.(env|env\.example|db|sqlite|sqlite3|p12|pfx)$">
  Require all denied
</FilesMatch>

Options -Indexes