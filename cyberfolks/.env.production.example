# Skopiuj ten plik do .env w katalogu głównym aplikacji.
# Nie wpisuj tutaj sekretów i nie commituj pliku .env.

NODE_ENV=production
DATABASE_URL="file:./data/prod.db"

# Integracje pozostają w trybie demo, dopóki nie skonfigurujesz produkcyjnych
# danych po stronie serwera.
KSEF_DEMO=true
KSEF_ENVIRONMENT=demo
GUS_BIR_API_KEY=

# Opcjonalne — ustawiaj wyłącznie w panelu jako zmienną server-only:
# KSEF_TOKEN=