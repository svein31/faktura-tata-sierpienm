# ── Środowisko Fakturo (MongoDB Atlas & Netlify) ────────────────────────
# Skopiuj do .env na serwerze / Netlify i uzupełnij. ŻADNYCH sekretów nie commituj.

# ── Trwała Baza danych w Chmurze (MongoDB Atlas) ─────────────────────────
# Na Netlify ustaw zmienną DATABASE_URL w panelu:
# Site configuration -> Environment variables -> Add a variable
#
# Format ciągu połączeniowego MongoDB Atlas:
# DATABASE_URL="mongodb+srv://<username>:<password>@<cluster-url>/fakturo?retryWrites=true&w=majority"
DATABASE_URL="mongodb+srv://twoj_uzytkownik:twoje_haslo@cluster0.abcde.mongodb.net/fakturo?retryWrites=true&w=majority"

# ── Auth & NextAuth JWT (30 dni) ─────────────────────────────────────────
# Wygeneruj losowy sekret 32-bajtowy (np. openssl rand -base64 32)
NEXTAUTH_SECRET="twoj-tajny-klucz-nextauth-jwt-zmien-w-produkcji"
NEXTAUTH_URL="https://twojadomena.netlify.app"

# ── GUS BIR 1.1 (Baza Internetowa REGON) ──────────────────────────────────
GUS_ENV=test
GUS_API_KEY=abcde12345abcde12345

# ── KSeF API 2.0 / Krajowy System e-Faktur (FA(3)) ────────────────────────
KSEF_ENV=test
KSEF_ENVIRONMENT=test
KSEF_NIP=5260301706
KSEF_TOKEN=

# ── Wysyłka E-mail (Resend / SMTP) ──────────────────────────────────────────
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM="Fakturo <faktury@twojadomena.pl>"
