# ── Środowisko Fakturo (przykład) ─────────────────────────────────────────
# Skopiuj do .env na serwerze / Netlify i uzupełnij. ŻADNYCH sekretów nie commituj.

# ── Trwała Baza danych w Chmurze (PostgreSQL / Supabase / Neon / RDS) ───
# Na Netlify / Vercel ustaw zmienną DATABASE_URL w panelu:
# Site configuration -> Environment variables -> Add a variable
#
# Przykłady URL dla PostgreSQL:
# Supabase: DATABASE_URL="postgresql://postgres.[project]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Neon:     DATABASE_URL="postgresql://[user]:[password]@[endpoint].neon.tech/neondb?sslmode=require"
# Standard: DATABASE_URL="postgresql://user:password@localhost:5432/fakturo?schema=public"
DATABASE_URL="postgresql://user:password@localhost:5432/fakturo?schema=public"

# ── Auth & NextAuth JWT (30 dni) ─────────────────────────────────────────
# Wygeneruj losowy sekret 32-bajtowy (np. openssl rand -base64 32 lub node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
NEXTAUTH_SECRET="twoj-tajny-klucz-nextauth-jwt-zmien-w-produkcji"
NEXTAUTH_URL="https://twojadomena.netlify.app"

# ── GUS BIR 1.1 (Baza Internetowa REGON) ──────────────────────────────────
# Środowisko GUS: "test" (wyszukiwarkaregontest.stat.gov.pl) lub "prod" (wyszukiwarkaregon.stat.gov.pl)
GUS_ENV=test
GUS_API_KEY=abcde12345abcde12345

# ── KSeF API 2.0 / Krajowy System e-Faktur (FA(3)) ────────────────────────
# Środowisko KSeF: "demo" (symulacja), "test" (ksef-test.mf.gov.pl), "production" (ksef.mf.gov.pl)
KSEF_ENV=test
KSEF_ENVIRONMENT=test
KSEF_NIP=5260301706
KSEF_TOKEN=

# ── Wysyłka E-mail (Resend / SMTP) ──────────────────────────────────────────
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM="Fakturo <faktury@twojadomena.pl>"
