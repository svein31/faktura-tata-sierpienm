# ── Środowisko Fakturo (przykład) ─────────────────────────────────────────
# Skopiuj do .env na serwerze i uzupełnij. ŻADNYCH sekretów nie commituj.

# ── Baza danych (SQLite) ──────────────────────────────────────────────────
# Ścieżka względna jest rozwiązywana względem katalogu prisma/,
# czyli ostatecznie: <katalog-aplikacji>/prisma/data/prod.db.
# Katalog data/ tworzony jest automatycznie przy starcie (src/lib/db.ts)
# i musi być zapisywalny dla użytkownika Node (chmod 775 / chown).
DATABASE_URL="file:./data/prod.db"

# ── Auth ──────────────────────────────────────────────────────────────────
# SESSION_SECRET NIE JEST WYMAGANY: używamy nieprzezroczystych tokenów sesji
# (32 losowe bajty), w bazie przechowywany jest wyłącznie hash SHA-256 tokena.
# Brak podpisywanych cookie/JWT — dlatego nie ma zmiennej SESSION_SECRET.
# (Gdybyś w przyszłości dodał JWT, wygeneruj sekret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")

# ── Integracje zewnętrzne (TRYB DEMO — jawnie zachowany) ─────────────────
# GUS BIR / REGON — prawdziwy lookup wymaga klucza API GUS (api.stat.gov.pl)
# i klienta SOAP. Bez klucza działa adapter demo.
GUS_BIR_API_KEY=

# KSeF — środowisko domyślne aplikacji (demo/test/production).
KSEF_DEMO=true
KSEF_ENVIRONMENT=demo

# Produkcyjny token KSeF — SERVER-ONLY. Ustawiaj wyłącznie po stronie serwera,
# NIGDY przez API/frontend. W tej wersji token nie jest używany do prawdziwej
# wysyłki (wysyłka działa w trybie demo) — patrz README → „KSeF w produkcji".
# KSEF_TOKEN=

# ── Serwer (cyber_Folks / Passenger) ──────────────────────────────────────
# PORT nadaje panel Node.js (zakres zależnie od panelu: 35100–35599 albo 54xxx).
# Aplikacja nasłuchuje na 127.0.0.1 (patrz app.js).
# PORT=
