# ── Środowisko Fakturo (przykład) ─────────────────────────────────────────
# Skopiuj do .env na serwerze i uzupełnij. ŻADNYCH sekretów nie commituj.

# ── Baza danych (Turso libSQL dla Netlify Serverless / SQLite dla VPS) ──
# Dla wdrożenia na Netlify Functions / Vercel (trwała baza serverless):
# Utwórz darmową bazę na https://turso.tech i wklej URL oraz Token:
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Dla lokalnego developmentu / tradycyjnego hostingu VPS (cyber_Folks):
# DATABASE_URL="file:./data/prod.db"
DATABASE_URL="file:./data/prod.db"

# ── Auth ──────────────────────────────────────────────────────────────────
# SESSION_SECRET NIE JEST WYMAGANY: używamy nieprzezroczystych tokenów sesji
# (32 losowe bajty), w bazie przechowywany jest wyłącznie hash SHA-256 tokena.
# Brak podpisywanych cookie/JWT — dlatego nie ma zmiennej SESSION_SECRET.
# (Gdybyś w przyszłości dodał JWT, wygeneruj sekret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")

# ── GUS BIR 1.1 (Baza Internetowa REGON) ──────────────────────────────────
# Środowisko GUS: "test" (wyszukiwarkaregontest.stat.gov.pl) lub "prod" (wyszukiwarkaregon.stat.gov.pl)
GUS_ENV=test
# Klucz API GUS: dla testów standardowy klucz to abcde12345abcde12345, dla produkcji uzyskany z api.stat.gov.pl
GUS_API_KEY=abcde12345abcde12345

# ── KSeF API 2.0 / Krajowy System e-Faktur (FA(3)) ────────────────────────
# Środowisko KSeF: "demo" (symulacja), "test" (ksef-test.mf.gov.pl), "production" (ksef.mf.gov.pl)
KSEF_ENV=test
KSEF_ENVIRONMENT=test

# NIP firmy do autoryzacji sesji KSeF
KSEF_NIP=5260301706

# Token autoryzacyjny KSeF wygenerowany w Aplikacji Podatnika KSeF
# (Służy do automatycznego logowania przez POST /api/ksef/auth/login)
KSEF_TOKEN=

# Opcjonalny własny klucz publiczny RSA MF (w formacie PEM).
# Jeśli puste, aplikacja używa wbudowanych oficjalnych kluczy publicznych KSeF.
# KSEF_PUBLIC_KEY_PEM=

# ── Wysyłka E-mail (Resend / SMTP) ──────────────────────────────────────────
# 1. Resend API (zalecane dla Netlify Serverless):
RESEND_API_KEY=
# 2. LUB serwer SMTP (Nodemailer):
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
# Adres nadawcy:
EMAIL_FROM="Fakturo <faktury@twojadomena.pl>"

# ── Serwer & Netlify Deploy ───────────────────────────────────────────────
# Na Netlify Functions / Next.js Serverless ustaw te same zmienne w panelu
# Netlify -> Site Configuration -> Environment Variables.
# PORT nadaje panel Node.js / Passenger w środowiskach VPS/hostingowych.
# PORT=
