# ── Środowisko Fakturo (MongoDB Atlas & Netlify) ────────────────────────
# Skopiuj do .env na serwerze / Netlify i uzupełnij. ŻADNYCH sekretów nie commituj.

# ── Trwała Baza danych w Chmurze (MongoDB Atlas) ─────────────────────────
# Na Netlify ustaw zmienną DATABASE_URL w panelu:
# Site configuration -> Environment variables -> Add a variable
#
# Format ciągu połączeniowego MongoDB Atlas:
# DATABASE_URL="mongodb+srv://<username>:<password>@<cluster-url>/fakturo?retryWrites=true&w=majority"
DATABASE_URL="mongodb+srv://twoj_uzytkownik:twoje_haslo@cluster0.abcde.mongodb.net/fakturo?retryWrites=true&w=majority"

# ── Auth & NextAuth JWT (30 dni) ─────────────────────────────────────────
# Wygeneruj losowy sekret 32-bajtowy (np. openssl rand -base64 32)
NEXTAUTH_SECRET="twoj-tajny-klucz-nextauth-jwt-zmien-w-produkcji"
NEXTAUTH_URL="https://twojadomena.netlify.app"

# ── Zaplanowane zadania Netlify (KSeF, przypomnienia, integracje) ────────
# W Netlify: produkcja, zakres Functions. Nie zapisuj prawdziwego sekretu w Git.
APP_URL="https://twojadomena.pl"
# Wygeneruj osobny losowy sekret (np. openssl rand -hex 32) i ustaw jako secret.
# Ta sama wartość musi być dostępna dla funkcji harmonogramu i tras API.
CRON_SECRET=""

# ── GUS BIR 1.1 (Baza Internetowa REGON) ──────────────────────────────────
GUS_ENV=test
GUS_API_KEY=abcde12345abcde12345

# ── KSeF API 2.0 / Krajowy System e-Faktur (FA(3)) ────────────────────────
KSEF_ENV=test
KSEF_ENVIRONMENT=test
KSEF_NIP=5260301706
KSEF_TOKEN=

# ── Wysyłka E-mail (Resend / SMTP) ──────────────────────────────────────────
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM="Fakturo <faktury@twojadomena.pl>"


# Optional OCR.space key. Documents are sent only after the user clicks OCR.
# Empty key keeps the inbox in manual review mode.
OCR_SPACE_API_KEY=""

# ── Płatności Stripe (Subskrypcje) ─────────────────────────────────────────
# W trybie testowym używaj kluczy sk_test_... i pk_test_...
# W produkcji użyj rk_live_... / sk_live_... i pk_live_...
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# Identyfikatory cen (utworzone w Stripe Dashboard lub za pomocą scripts/setup-stripe-products.mjs):
STRIPE_PRICE_ID_MONTHLY="price_..."
STRIPE_PRICE_ID_YEARLY="price_..."

