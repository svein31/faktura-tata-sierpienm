// SEKCJA 5 — INTEGRACJE BANK / E-COMMERCE / PUBLICZNE API
// ════════════════════════════════════════════════════════════════════════

/// Połączenie Open Banking PSD2 / AISP (GoCardless Bank Account Data — dawniej Nordigen, albo Tink)
model BankConnection {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String? @db.ObjectId

  /// "gocardless" | "tink"
  provider        String
  institutionId   String
  institutionName String @default("")
  institutionBic  String?
  countryCode     String @default("PL")

  /// GoCardless: requisition id | Tink: credentials id
  externalRefId String?
  /// Własny identyfikator referencyjny przekazany do dostawcy
  reference     String?
  /// URL do autoryzacji w banku (SCA)
  authLink      String?

  /// pending | linked | expired | revoked | error
  status           String    @default("pending")
  consentGivenAt   DateTime?
  consentExpiresAt DateTime?
  /// Maksymalna liczba dni historii transakcji udęostepniona przez bank
  maxHistoryDays   Int       @default(90)

  /// [{ id, iban, currency, name, ownerName, product }]
  accounts Json?

  /// Auto-import 1×/dobę — zgodnie z limitem PSD2 dla dostępu bez obecności użytkownika
  syncIntervalHours Int      @default(24)
  autoSyncEnabled   Boolean  @default(true)
  autoMatchEnabled  Boolean  @default(true)
  lastSyncAt        DateTime?
  nextSyncAt        DateTime?
  lastSyncCount     Int      @default(0)
  lastSyncMatched   Int      @default(0)
  errorMessage      String?
  failureCount      Int      @default(0)

  transactions BankTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status, nextSyncAt])
  @@index([externalRefId])
}

/// Transakcja bankowa — z PSD2, CSV lub MT940 (wspólny rejestr i parowanie)
model BankTransaction {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  connectionId String?         @db.ObjectId
  connection   BankConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  accountId   String?
  accountIban String?
  /// Identyfikator transakcji u dostawcy / hash wiersza przy CSV i MT940
  externalId  String

  bookingDate String
  valueDate   String?
  amount      Float
  currency    String @default("PLN")
  /// "in" (wpływ) | "out" (wypłata)
  direction   String

  description       String  @default("")
  counterpartyName  String?
  counterpartyIban  String?
  endToEndId        String?
  bankTransactionCode String?

  /// "psd2" | "csv" | "mt940"
  source   String @default("psd2")
  importId String? @db.ObjectId

  /// unmatched | matched | manual | ambiguous | ignored
  matchStatus     String  @default("unmatched")
  matchedInvoiceId String? @db.ObjectId
  matchedInvoiceNumber String?
  matchedExpenseId String? @db.ObjectId
  /// 0..1 — pewność automatycznego dopasowania
  matchConfidence Float   @default(0)
  /// Lista przesłanek dopasowania, np. ["number", "amount_exact", "iban"]
  matchSignals    String[] @default([])
  matchedAt       DateTime?
  paymentRecordId String?  @db.ObjectId
  /// Kandydaci przy dopasowaniu niejednoznacznym: [{ invoiceId, number, score, signals }]
  matchCandidates Json?

  raw Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, externalId])
  @@index([userId, bookingDate])
  @@index([userId, matchStatus])
  @@index([connectionId])
}

/// Integracja e-commerce: Allegro / WooCommerce / Shopify
model EcommerceIntegration {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String? @db.ObjectId

  /// "allegro" | "woocommerce" | "shopify"
  platform String
  name     String @default("")
  shopUrl  String?
  externalShopId String?

  /// Zaszyfrowane poświadczenia (AES-256-GCM) — nigdy nie zwracane do klienta
  credentialsEnc String?
  /// Maski do wyświetlenia, np. { clientId: "abc1…", tokenMask: "••••4f2a" }
  credentialsMask Json?

  /// disconnected | connected | error | expired
  status       String    @default("disconnected")
  tokenExpiresAt DateTime?

  /// Auto-faktura do zamówienia
  autoInvoice      Boolean @default(true)
  /// Po wystawieniu → wyślij do KSeF
  autoSendKsef     Boolean @default(true)
  /// Po wystawieniu → wyślij PDF na e-mail klienta
  autoEmailClient  Boolean @default(true)
  /// Tworóz fakturę tylko dla zamówień opłaconych
  onlyPaidOrders   Boolean @default(true)
  /// Tworóz fakturę tylko gdy kupujący zażądał faktury
  onlyRequested    Boolean @default(false)
  defaultVatRate   String  @default("23")
  defaultUnit      String  @default("szt.")
  invoicePrefix    String? @default("")
  paymentTermDays  Int     @default(0)
  /// Odejmij WZ z magazynu dla zamówień (sekcja 4)
  createStockDocuments Boolean @default(false)
  warehouseId      String? @db.ObjectId

  syncIntervalMinutes Int      @default(60)
  lastSyncAt          DateTime?
  nextSyncAt          DateTime?
  lastSyncCount       Int      @default(0)
  /// Nie importuj zamówień starszych niż ta data
  importOrdersSince   String?
  webhookSecret       String?
  errorMessage        String?
  failureCount        Int      @default(0)

  orders EcommerceOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, platform, externalShopId])
  @@index([userId])
  @@index([status, nextSyncAt])
}

/// Zamówienie zaimportowane z platformy e-commerce
model EcommerceOrder {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  integrationId String               @db.ObjectId
  integration   EcommerceIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  platform        String
  externalOrderId String
  orderNumber     String?

  /// { name, nip?, email, phone?, address: { street, city, postal, country }, isCompany, wantsInvoice }
  buyer Json
  /// [{ name, sku?, quantity, unit, netPrice, vatRate, grossPrice }]
  lines Json

  totalNet   Float  @default(0)
  totalVat   Float  @default(0)
  totalGross Float  @default(0)
  currency   String @default("PLN")
  shippingGross Float @default(0)

  /// paid | unpaid | refunded | cancelled
  paymentStatus String @default("unpaid")
  orderedAt     String
  paidAt        String?

  /// imported | invoiced | skipped | error
  status        String  @default("imported")
  invoiceId     String? @db.ObjectId
  invoiceNumber String?
  ksefNumber    String?
  emailSentAt   DateTime?
  skipReason    String?
  errorMessage  String?

  raw Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, platform, externalOrderId])
  @@index([userId, status])
  @@index([integrationId])
}

/// Klucz publicznego REST API (widoczny raz przy tworzeniu, w bazie tylko hash SHA-256)
model ApiKey {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String? @db.ObjectId

  name String
  /// Widoczny prefiks, np. "fk_live_a1b2c3" — do identyfikacji w UI
  keyPrefix String
  /// SHA-256 pełnego klucza
  keyHash   String @unique
  /// "live" | "test"
  environment String @default("live")

  /// invoices:read invoices:write contractors:read contractors:write products:read
  /// products:write expenses:read expenses:write warehouse:read warehouse:write
  /// tax:read ksef:send webhooks:manage
  scopes String[] @default(["invoices:read"])

  rateLimitPerMinute Int      @default(120)
  requestCount       Int      @default(0)
  lastUsedAt         DateTime?
  lastUsedIp         String?
  expiresAt          DateTime?
  revokedAt          DateTime?
  revokedReason      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([keyPrefix])
}

/// Webhook wychodzący (Zapier / Make / n8n / custom)
model Webhook {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  url         String
  description String?
  /// "zapier" | "make" | "n8n" | "custom"
  target      String  @default("custom")

  /// invoice.created | invoice.issued | invoice.paid | invoice.overdue | ksef.accepted
  /// | ksef.rejected | expense.created | contractor.created | offer.accepted
  /// | order.completed | stock.low | stock.document.created | bank.transaction.matched
  /// | tax.settlement.due
  events String[] @default([])

  /// Sekret do podpisu HMAC-SHA256 nagłówka X-Fakturo-Signature
  secret String
  active Boolean @default(true)

  deliveryCount  Int       @default(0)
  failureCount   Int       @default(0)
  lastDeliveryAt DateTime?
  lastStatus     Int?
  lastError      String?
  /// Po 10 kolejnych błędach webhook jest automatycznie wyłączany
  disabledAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([active])
}

