// ─────────────────────────────────────────────────────────────────────────────
// Fakturo — schema Prisma (SQLite, cyber_Folks compatible)
//
// DATABASE_URL=file:./data/prod.db  — ścieżka względna jest rozwiązywana
// względem katalogu prisma/ → plik bazy: <app>/prisma/data/prod.db
// Katalog data/ jest tworzony automatycznie przy starcie aplikacji
// (patrz src/lib/db.ts) i musi być zapisywalny dla użytkownika Node.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String                 @id @default(cuid())
  email         String                 @unique
  passwordHash  String
  name          String
  nip           String?                @default("")
  companyName   String?                @default("")
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  sessions      Session[]
  company       CompanySettings?
  companyProfiles CompanyProfile[]
  ksef          KsefSettings?
  contractors   Contractor[]
  products      Product[]
  invoices      Invoice[]
  ksefSessions  KsefSession[]
  notifications Notification[]
  preferences   NotificationPreference?
}

/// Trwała sesja użytkownika powiązana bezpośrednio z rekordem w bazie danych
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@index([sessionToken])
}

model CompanySettings {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String   @default("")
  nip       String   @default("")
  regon     String   @default("")
  street    String   @default("")
  city      String   @default("")
  postal    String   @default("")
  country   String   @default("PL")
  iban      String   @default("")
  bankName  String   @default("")
  email     String   @default("")
  phone     String   @default("")
  updatedAt DateTime @updatedAt
}

/// Ustawienia KSeF. Pełny token NIGDY nie jest zwracany przez API — zapisywane
/// są tylko flagi tokenSet + tokenMask (ostatnie 4 znaki). Produkcyjny token
/// powinien pochodzić ze zmiennej środowiskowej po stronie serwera (README).
model KsefSettings {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  environment  String   @default("demo")
  tokenSet     Boolean  @default(false)
  tokenMask    String   @default("")
  certName     String   @default("")
  autoValidate Boolean  @default(true)
  updatedAt    DateTime @updatedAt
}

/// Sesja uwierzytelniona KSeF API 2.0 (JWT Access Token)
model KsefSession {
  id                  String    @id @default(cuid())
  userId              String?
  user                User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nip                 String
  environment         String    @default("test") // demo | test | production
  referenceNumber     String    @unique
  authenticationToken String?
  accessToken         String?
  refreshToken        String?
  validUntil          DateTime?
  status              String    @default("ACTIVE") // ACTIVE | EXPIRED | TERMINATED
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  invoices            Invoice[]

  @@index([nip])
  @@index([userId])
}

model Contractor {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  nip        String
  regon      String?
  address    Json
  email      String?
  phone      String?
  iban       String?
  bankName   String?
  isVatPayer Boolean  @default(true)
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

model Product {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  sku         String?
  unit        String   @default("szt.")
  netPrice    Float    @default(0)
  vatRate     String   @default("23")
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model CompanyProfile {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  nip            String
  companyName    String
  street         String?
  buildingNumber String?
  flatNumber     String?
  city           String?
  postalCode     String?
  bankAccount    String?
  ksefToken      String?
  isDefault      Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  invoices       Invoice[]

  @@unique([userId, nip])
  @@index([userId])
}

/// Faktura. Pola strukturalne (lines, ksef) trzymane jako JSON, aby zachować
/// istniejące typy frontendu bez migracji danych.
model Invoice {
  id              String          @id @default(cuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  number          String
  type            String
  status          String          @default("draft")
  contractorId    String
  sellerCompanyId String?
  sellerCompany   CompanyProfile? @relation(fields: [sellerCompanyId], references: [id], onDelete: SetNull)
  issueDate       String
  saleDate        String
  dueDate         String
  currency        String          @default("PLN")
  language        String          @default("PL")
  paymentMethod   String          @default("transfer")
  paymentTermDays Int             @default(14)
  notes           String?
  lines           Json
  ksef            Json?
  nip             String?         @default("")
  totalGross      Float?          @default(0)
  ksefNumber      String?
  referenceNumber String?
  upoXml          String?
  ksefSessionId   String?
  ksefSession     KsefSession?    @relation(fields: [ksefSessionId], references: [id], onDelete: SetNull)
  sentAt          DateTime?
  sentToEmail     String?
  emailStatus     String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([userId])
  @@index([sellerCompanyId])
  @@index([referenceNumber])
  @@index([ksefNumber])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String   @default("system")
  title     String
  body      String?
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

model NotificationPreference {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  browserEnabled Boolean  @default(false)
  soundEnabled   Boolean  @default(true)
  updatedAt      DateTime @updatedAt
}
