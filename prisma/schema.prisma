// ─────────────────────────────────────────────────────────────────────────────
// Fakturo — schema Prisma (MongoDB Atlas)
//
// DATABASE_URL="mongodb+srv://<username>:<password>@cluster.mongodb.net/fakturo?retryWrites=true&w=majority"
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id              String                 @id @default(auto()) @map("_id") @db.ObjectId
  email           String                 @unique
  password        String                 // Zawsze zhashowane bcrypt (12 rund)
  name            String?                @default("")
  nip             String?                @default("")
  companyName     String?                @default("")
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  sessions        Session[]
  company         CompanySettings?
  companyProfiles CompanyProfile[]
  ksef            KsefSettings?
  contractors     Contractor[]
  products        Product[]
  invoices        Invoice[]
  ksefSessions    KsefSession[]
  notifications   Notification[]
  preferences     NotificationPreference?
}

/// Trwała sesja użytkownika powiązana z bazą danych
model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

model CompanySettings {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @unique @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String   @default("")
  nip       String   @default("")
  regon     String   @default("")
  street    String   @default("")
  city      String   @default("")
  postal    String   @default("")
  country   String   @default("PL")
  iban      String   @default("")
  bankName  String   @default("")
  email     String   @default("")
  phone     String   @default("")
  updatedAt DateTime @updatedAt
}

/// Ustawienia KSeF
model KsefSettings {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  userId       String   @unique @db.ObjectId
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  environment  String   @default("demo")
  tokenSet     Boolean  @default(false)
  tokenMask    String   @default("")
  certName     String   @default("")
  autoValidate Boolean  @default(true)
  updatedAt    DateTime @updatedAt
}

/// Sesja uwierzytelniona KSeF API 2.0
model KsefSession {
  id                  String    @id @default(auto()) @map("_id") @db.ObjectId
  userId              String?   @db.ObjectId
  user                User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nip                 String
  environment         String    @default("test")
  referenceNumber     String    @unique
  authenticationToken String?
  accessToken         String?
  refreshToken        String?
  validUntil          DateTime?
  status              String    @default("ACTIVE")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  invoices            Invoice[]

  @@index([nip])
  @@index([userId])
}

model Contractor {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String   @db.ObjectId
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  nip        String
  regon      String?
  address    Json
  email      String?
  phone      String?
  iban       String?
  bankName   String?
  isVatPayer Boolean  @default(true)
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

model Product {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  sku         String?
  unit        String   @default("szt.")
  netPrice    Float    @default(0)
  vatRate     String   @default("23")
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model CompanyProfile {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  userId         String    @db.ObjectId
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  nip            String
  companyName    String
  street         String?
  buildingNumber String?
  flatNumber     String?
  city           String?
  postalCode     String?
  bankAccount    String?
  ksefToken      String?
  isDefault      Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  invoices       Invoice[]

  @@unique([userId, nip])
  @@index([userId])
}

/// Faktura
model Invoice {
  id              String          @id @default(auto()) @map("_id") @db.ObjectId
  userId          String          @db.ObjectId
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  number          String
  type            String
  status          String          @default("draft")
  contractorId    String
  sellerCompanyId String?         @db.ObjectId
  sellerCompany   CompanyProfile? @relation(fields: [sellerCompanyId], references: [id], onDelete: SetNull)
  issueDate       String
  saleDate        String
  dueDate         String
  currency        String          @default("PLN")
  language        String          @default("PL")
  paymentMethod   String          @default("transfer")
  paymentTermDays Int             @default(14)
  notes           String?
  lines           Json
  ksef            Json?
  nip             String?         @default("")
  totalGross      Float?          @default(0)
  ksefNumber      String?
  referenceNumber String?
  upoXml          String?
  ksefSessionId   String?         @db.ObjectId
  ksefSession     KsefSession?    @relation(fields: [ksefSessionId], references: [id], onDelete: SetNull)
  sentAt          DateTime?
  sentToEmail     String?
  emailStatus     String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([userId])
  @@index([sellerCompanyId])
  @@index([referenceNumber])
  @@index([ksefNumber])
}

model Notification {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String   @default("system")
  title     String
  body      String?
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

model NotificationPreference {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  userId         String   @unique @db.ObjectId
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  browserEnabled Boolean  @default(false)
  soundEnabled   Boolean  @default(true)
  updatedAt      DateTime @updatedAt
}
