/// Stan magazynowy pozycji w danym magazynie (żywy licznik)
model StockItem {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  warehouseId String    @db.ObjectId
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  productId   String?   @db.ObjectId
  product     Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)

  sku  String
  name String
  unit String @default("szt.")

  /// Stan bieżący
  quantity     Float @default(0)
  /// Ilość zarezerwowana (faktury w statusie draft/ready)
  reserved     Float @default(0)
  /// Próg alertu niskiego stanu
  minQuantity  Float @default(0)
  /// Średnia ważona cena zakupu netto (wycena rozchodu)
  avgPurchasePrice  Float @default(0)
  lastPurchasePrice Float @default(0)
  /// Wartość magazynowa = quantity × avgPurchasePrice
  valueNet     Float @default(0)
  location     String?

  lastMovementAt DateTime?
  lowStockAlertedAt DateTime?

  movements StockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([warehouseId, sku])
  @@index([userId])
  @@index([userId, quantity])
}

/// Dokument magazynowy: WZ | PZ | RW | PW | MM
model StockDocument {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  warehouseId String    @db.ObjectId
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  number String
  /// WZ (wydanie zewnętrzne) | PZ (przyjęcie zewnętrzne) | RW (rozchód wewnętrzny)
  /// | PW (przychód wewnętrzny) | MM (przesunięcie międzymagazynowe)
  type   String
  /// "out" | "in" | "transfer"
  direction String
  /// draft | issued | cancelled
  status    String @default("issued")
  issueDate String

  /// invoice | expense | manual | stocktaking | ecommerce | api
  sourceType   String  @default("manual")
  sourceId     String?
  sourceNumber String?
  /// true = dokument utworzony automatycznie (WZ przy FV, PZ przy FZ)
  isAutomatic  Boolean @default(false)

  contractorId   String?
  contractorName String?

  /// Magazyn docelowy dla MM
  targetWarehouseId   String? @db.ObjectId
  targetWarehouseName String?
  /// Dokument sparowany (MM tworzy parę wydanie + przyjęcie)
  pairedDocumentId    String? @db.ObjectId

  /// [{ stockItemId, productId, sku, name, unit, quantity, unitPriceNet, valueNet }]
  lines Json
  totalQuantity Float @default(0)
  totalValueNet Float @default(0)

  notes      String?
  issuedBy   String?
  receivedBy String?
  cancelledAt DateTime?
  cancelReason String?

  movements StockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, number])
  @@index([userId, type])
  @@index([userId, issueDate])
  @@index([sourceType, sourceId])
}

/// Nieusuwalny ślad każdej zmiany stanu magazynowego
model StockMovement {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  warehouseId String    @db.ObjectId
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  stockItemId String    @db.ObjectId
  stockItem   StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)

  documentId     String?        @db.ObjectId
  document       StockDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  documentNumber String?
  documentType   String?

  sku  String
  name String
  /// Zmiana ilości: dodatnia (przyjęcie) / ujemna (wydanie)
  quantityChange Float
  quantityBefore Float @default(0)
  quantityAfter  Float @default(0)
  unitPriceNet   Float @default(0)
  valueNet       Float @default(0)
  reason         String?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([stockItemId, createdAt])
  @@index([documentId])
}

/// Remanent / inwentaryzacja (spis z natury)
model Stocktaking {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  warehouseId String    @db.ObjectId
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  number    String
  /// open | counting | closed | cancelled
  status    String @default("open")
  countDate String

  /// [{ stockItemId, sku, name, unit, expectedQuantity, countedQuantity, diffQuantity,
  ///    unitPriceNet, expectedValueNet, countedValueNet, diffValueNet, counted }]
  lines Json

  totalExpectedQuantity Float @default(0)
  totalCountedQuantity  Float @default(0)
  totalDiffQuantity     Float @default(0)
  totalExpectedValueNet Float @default(0)
  totalCountedValueNet  Float @default(0)
  totalDiffValueNet     Float @default(0)
  shortageValueNet      Float @default(0) // niedobór → RW
  surplusValueNet       Float @default(0) // nadwyżka → PW

  /// Numery dokumentów korygujących wygenerowanych przy zamknięciu remanentu
  adjustmentDocumentIds     String[] @default([])
  adjustmentDocumentNumbers String[] @default([])

  notes    String?
  closedAt DateTime?
  closedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, number])
  @@index([userId, status])
}

