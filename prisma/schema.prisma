// SEKCJA 7 — PWA / SKAN FAKTURY Z APARATU (OCR)
// ════════════════════════════════════════════════════════════════════════

/// Zdjęcie faktury/paragonu zrobione aparatem → OCR → moduł kosztów
model ExpenseScan {
  ocrResult Json?
  companyId String? @db.ObjectId
  sha256 String?
  version Int @default(1)
  @@index([companyId, createdAt])
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  fileName  String?
  mimeType  String  @default("image/jpeg")
  sizeBytes Int     @default(0)
  /// Obraz jako data URL (limit 4 MB) — zgodnie z RODO usuwany razem z kosztem
  imageData String?
  /// "camera" | "upload"
  captureSource String @default("camera")

  /// pending | processing | parsed | needs_review | failed | converted
  status String @default("pending")
  /// "ocrspace" | "google_vision" | "mindee" | "azure_di" | "manual"
  provider String?
  rawText  String?
  /// { number, contractorName, nip, issueDate, dueDate, totalNet, totalVat, totalGross,
  ///   currency, category, iban, fieldConfidence: {…} }
  parsed     Json?
  confidence Float?

  expenseId    String? @db.ObjectId
  errorMessage String?
  processedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([userId, createdAt])
}





