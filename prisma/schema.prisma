// ─────────────────────────────────────────────────────────────────────────────
// Fakturo — schema Prisma (MongoDB Atlas)
//
// DATABASE_URL="mongodb+srv://<username>:<password>@cluster.mongodb.net/fakturo?retryWrites=true&w=majority"
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id                  String                  @id @default(auto()) @map("_id") @db.ObjectId
  email               String                  @unique
  password            String // Zawsze zhashowane bcrypt (12 rund)
  name                String?                 @default("")
  nip                 String?                 @default("")
  companyName         String?                 @default("")
  role                String                  @default("owner") // "owner" | "accountant" | "viewer"
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  sessions            Session[]
  resetTokens         PasswordResetToken[]
  auditLogs           AuditLog[]
  paymentRecords      PaymentRecord[]
  ksefTasks           KsefQueueTask[]
  company             CompanySettings?
  companyProfiles     CompanyProfile[]
  ksef                KsefSettings?
  contractors         Contractor[]
  products            Product[]
  invoices            Invoice[]
  ksefSessions        KsefSession[]
  incomingKsefImports KsefIncomingImport[]
  notifications       Notification[]
  preferences         NotificationPreference?
}

/// Trwała sesja użytkownika powiązana z bazą danych
model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

model CompanySettings {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @unique @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String   @default("")
  nip       String   @default("")
  regon     String   @default("")
  street    String   @default("")
  city      String   @default("")
  postal    String   @default("")
  country   String   @default("PL")
  iban      String   @default("")
  bankName  String   @default("")
  email     String   @default("")
  phone     String   @default("")
  logoUrl   String?  @default("")
  updatedAt DateTime @updatedAt
}

/// Ustawienia KSeF
model KsefSettings {
  id                 String    @id @default(auto()) @map("_id") @db.ObjectId
  userId             String    @unique @db.ObjectId
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  environment        String    @default("demo")
  tokenSet           Boolean   @default(false)
  tokenMask          String    @default("")
  certName           String    @default("")
  autoValidate          Boolean   @default(true)
  lastIncomingSyncAt    DateTime?
  autoSyncEnabled       Boolean   @default(false)
  autoSyncIntervalHours Int       @default(1)
  autoSyncNotifyEmail   String?   @default("")
  lastAutoSyncAt        DateTime?
  updatedAt             DateTime  @updatedAt
}

/// Sesja uwierzytelniona KSeF API 2.0
model KsefSession {
  id                  String    @id @default(auto()) @map("_id") @db.ObjectId
  userId              String?   @db.ObjectId
  user                User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nip                 String
  environment         String    @default("test")
  referenceNumber     String    @unique
  authenticationToken String?
  accessToken         String?
  refreshToken        String?
  validUntil          DateTime?
  status              String    @default("ACTIVE")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  invoices            Invoice[]

  @@index([nip])
  @@index([userId])
}

model KsefIncomingImport {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  userId              String   @db.ObjectId
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ksefReferenceNumber String   @unique
  invoiceId           String?  @db.ObjectId
  createdAt           DateTime @default(now())

  @@index([userId])
}

model Contractor {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String   @db.ObjectId
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  nip        String
  regon      String?
  address    Json
  email      String?
  phone      String?
  iban       String?
  bankName   String?
  isVatPayer Boolean  @default(true)
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

model Product {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  sku         String?
  unit        String   @default("szt.")
  netPrice    Float    @default(0)
  vatRate     String   @default("23")
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model CompanyProfile {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  userId         String    @db.ObjectId
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  nip            String
  companyName    String
  street         String?
  buildingNumber String?
  flatNumber     String?
  city           String?
  postalCode     String?
  bankAccount    String?
  ksefToken      String?
  isDefault      Boolean   @default(false)
  logoUrl        String?   @default("")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  invoices       Invoice[]

  @@unique([userId, nip])
  @@index([userId])
}

/// Faktura
model Invoice {
  id              String          @id @default(auto()) @map("_id") @db.ObjectId
  userId          String          @db.ObjectId
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  number          String
  type            String
  status          String          @default("draft")
  contractorId    String
  sellerCompanyId String?         @db.ObjectId
  sellerCompany   CompanyProfile? @relation(fields: [sellerCompanyId], references: [id], onDelete: SetNull)
  issueDate       String
  saleDate        String
  dueDate         String
  currency        String          @default("PLN")
  language        String          @default("PL")
  paymentMethod   String          @default("transfer")
  paymentTermDays Int             @default(14)
  notes           String?
  lines           Json
  ksef            Json?
  nip             String?         @default("")
  totalNet        Float?          @default(0)
  totalVat        Float?          @default(0)
  totalGross      Float?          @default(0)
  ksefNumber      String?
  referenceNumber String?
  upoXml          String?
  ksefXml         String?
  ksefSessionId   String?         @db.ObjectId
  ksefSession     KsefSession?    @relation(fields: [ksefSessionId], references: [id], onDelete: SetNull)
  sentAt          DateTime?
  sentToEmail     String?
  emailStatus     String?
  approvalStatus  String?         @default("pending")
  approvedAt      DateTime?
  approvedBy      String?
  // Rozszerzony cykl życia dokumentu, KSeF i płatności
  documentStatus  String?         @default("draft") // draft | ready | issued | cancelled
  ksefStatus      String?         @default("none")  // none | draft | ready | queued | sending | accepted | rejected | verify_needed
  paymentStatus   String?         @default("unpaid") // unpaid | partially_paid | paid | overdue
  paidAmount      Float?          @default(0)
  version         Int?            @default(1)
  // Obsługa faktur korygujących (KOR)
  isCorrection    Boolean?        @default(false)
  correctionReason String?
  originalInvoiceId String?
  originalInvoiceNumber String?
  originalKsefNumber String?
  originalIssueDate String?
  originalLines   Json?
  // Obsługa trybów offline i kodów QR
  isOffline       Boolean?        @default(false)
  offlineReason   String?
  offlineDeadline DateTime?
  qrCodeI         String?
  qrCodeII        String?
  // Faktury cykliczne
  isRecurring     Boolean?        @default(false)
  recurringInterval String?       // monthly | quarterly | yearly
  recurringNextDate String?
  recurringPaused Boolean?        @default(false)
  recurringAutoSend Boolean?      @default(false)
  // Przypomnienia o płatności
  lastPaymentReminderSentAt DateTime?
  paymentReminderCount      Int?    @default(0)
  // Relacje
  payments        PaymentRecord[]
  ksefTasks       KsefQueueTask[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([userId])
  @@index([sellerCompanyId])
  @@index([referenceNumber])
  @@index([ksefNumber])
  @@index([ksefStatus])
  @@index([paymentStatus])
}

model Notification {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String   @default("system")
  title     String
  body      String?
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

model NotificationPreference {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  userId         String   @unique @db.ObjectId
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  browserEnabled Boolean  @default(false)
  soundEnabled   Boolean  @default(true)
  updatedAt      DateTime @updatedAt
}

model PasswordResetToken {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  userId    String    @db.ObjectId
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model PaymentRecord {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  invoiceId String   @db.ObjectId
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Float
  paidAt    DateTime @default(now())
  method    String   @default("transfer")
  note      String?
  createdAt DateTime @default(now())

  @@index([invoiceId])
  @@index([userId])
}

model KsefQueueTask {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  userId         String    @db.ObjectId
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoiceId      String    @db.ObjectId
  invoice        Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  environment    String    @default("test")
  status         String    @default("queued") // queued | processing | completed | failed | verify_needed
  attempts       Int       @default(0)
  maxAttempts    Int       @default(5)
  lastAttemptAt  DateTime?
  nextAttemptAt  DateTime?
  lockedUntil    DateTime?
  errorDetails   String?
  idempotencyKey String    @unique
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, nextAttemptAt])
  @@index([userId])
  @@index([invoiceId])
}

model AuditLog {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String   @db.ObjectId
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action     String   // e.g. "ksef_send", "invoice_approve", "export_generated", "payment_add"
  entityType String   // "invoice", "payment", "ksef_session"
  entityId   String
  details    Json?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
}

