// ─────────────────────────────────────────────────────────────────────────────
// Fakturo — schema Prisma (MongoDB Atlas)
//
// DATABASE_URL="mongodb+srv://<username>:<password>@cluster.mongodb.net/fakturo?retryWrites=true&w=majority"
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  billingQuotaVersion Int? @default(0)
  workspacePreferences Json?
  id                  String                  @id @default(auto()) @map("_id") @db.ObjectId
  email               String                  @unique
  password            String // Zawsze zhashowane bcrypt (12 rund)
  name                String?                 @default("")
  nip                 String?                 @default("")
  companyName         String?                 @default("")
  role                String                  @default("owner") // "owner" | "accountant" | "viewer"
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  mfa                 UserMfa?
  sessions            Session[]
  resetTokens         PasswordResetToken[]
  auditLogs           AuditLog[]
  paymentRecords      PaymentRecord[]
  ksefTasks           KsefQueueTask[]
  company             CompanySettings?
  companyProfiles     CompanyProfile[]
  ksef                KsefSettings?
  contractors         Contractor[]
  products            Product[]
  invoices            Invoice[]
  ksefSessions        KsefSession[]
  incomingKsefImports KsefIncomingImport[]
  notifications       Notification[]
  preferences         NotificationPreference?
  offers              Offer[]
  orders              Order[]
  expenses            Expense[]
  bankImports         BankStatementImport[]
  comments            DocumentComment[]
  sentInvitations     TeamInvitation[]
  invoiceEmailLogs    InvoiceEmailLog[]
  companyMemberships  CompanyMember[]
  termsAcceptedAt     DateTime?
  termsAcceptedVersion String?
  legalConsents       LegalConsent[]
  // Podatki / ZUS / JPK (sekcja 3)
  taxProfile          TaxProfile?
  taxSettlements      TaxSettlement[]
  jpkExports          JpkExport[]
  whitelistChecks     WhitelistCheck[]
  // Magazyn WMS (sekcja 4)
  warehouses          Warehouse[]
  stockItems          StockItem[]
  stockDocuments      StockDocument[]
  stockMovements      StockMovement[]
  stocktakings        Stocktaking[]
  // Integracje bank / e-commerce / API (sekcja 5)
  bankConnections     BankConnection[]
  bankTransactions    BankTransaction[]
  ecommerceIntegrations EcommerceIntegration[]
  ecommerceOrders     EcommerceOrder[]
  apiKeys             ApiKey[]
  webhooks            Webhook[]
  // PWA / OCR (sekcja 7)
  expenseScans        ExpenseScan[]
  subscription        Subscription?
}

/// Stan planu aplikacji; brak rekordu oznacza brak aktywnej subskrypcji.
model Subscription {
  id                    String    @id @default(auto()) @map("_id") @db.ObjectId
  userId                String    @unique @db.ObjectId
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeCustomerId      String?   @unique
  stripeSubscriptionId  String?   @unique
  stripePriceId         String?
  accessSource          String?   // complimentary; null for existing Stripe subscriptions
  plan                  String?   // monthly | yearly
  status                String    @default("inactive") // inactive | active | past_due | canceled | trialing | unpaid
  currentPeriodEnd      DateTime?
  cancelAtPeriodEnd     Boolean?  @default(false)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

/// Trwała sesja użytkownika powiązana z bazą danych
model Session {
  mfaVerifiedAt DateTime?
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

model CompanySettings {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @unique @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String   @default("")
  nip       String   @default("")
  regon     String   @default("")
  street    String   @default("")
  city      String   @default("")
  postal    String   @default("")
  country   String   @default("PL")
  iban      String   @default("")
  bankName  String   @default("")
  email     String   @default("")
  phone     String   @default("")
  logoUrl   String?  @default("")
  updatedAt DateTime @updatedAt
}

/// Ustawienia KSeF
model KsefSettings {
  id                 String    @id @default(auto()) @map("_id") @db.ObjectId
  userId             String    @unique @db.ObjectId
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  environment        String    @default("demo")
  tokenSet           Boolean   @default(false)
  tokenMask          String    @default("")
  certName           String    @default("")
  autoValidate          Boolean   @default(true)
  lastIncomingSyncAt    DateTime?
  autoSyncEnabled       Boolean   @default(false)
  autoSyncIntervalHours Int       @default(1)
  autoSyncNotifyEmail   String?   @default("")
  lastAutoSyncAt        DateTime?
  updatedAt             DateTime  @updatedAt
}

/// Sesja uwierzytelniona KSeF API 2.0
model KsefSession {
  id                  String    @id @default(auto()) @map("_id") @db.ObjectId
  userId              String?   @db.ObjectId
  user                User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nip                 String
  environment         String    @default("test")
  referenceNumber     String    @unique
  authenticationToken String?
  accessToken         String?
  refreshToken        String?
  validUntil          DateTime?
  status              String    @default("ACTIVE")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  invoices            Invoice[]

  @@index([nip])
  @@index([userId])
}

model KsefIncomingImport {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  userId              String   @db.ObjectId
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ksefReferenceNumber String   @unique
  invoiceId           String?  @db.ObjectId
  createdAt           DateTime @default(now())

  @@index([userId])
}

model Contractor {
  companyId  String?  @db.ObjectId

  @@index([companyId])
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String   @db.ObjectId
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  nip        String
  regon      String?
  address    Json
  email      String?
  phone      String?
  iban       String?
  bankName   String?
  isVatPayer             Boolean   @default(true)
  notes                  String?
  tags                   String[]  @default([])
  defaultCurrency        String?   @default("PLN")
  defaultPaymentTermDays Int?      @default(14)
  defaultDiscountPercent Float?    @default(0)
  contacts               Json?     // Lista osób kontaktowych: [{ name, email, phone, role }]
  vatStatus              String?   // "czynny" | "zwolniony" | "nieznany"
  vatCheckedAt           DateTime?
  vatCheckSource         String?   // "mf_whitelist" | "gus_bir" | "manual"
  taxIdType              String?   @default("nip") // "nip" | "vat_eu" | "tin" | "other" | "none"
  taxId                  String?   // Pełny identyfikator zachowujący litery, separatory i zera wiodące
  country                String?   @default("PL")

  // ── CRM 360° (sekcja 6) ────────────────────────────────────────────────
  /// Limit kupiecki — maksymalna dopuszczalna suma nierozliczonych należności
  creditLimit            Float?    @default(0)
  creditLimitCurrency    String?   @default("PLN")
  /// true = blokuje wystawienie faktury po przekroczeniu limitu, false = tylko ostrzega
  creditLimitBlocking    Boolean?  @default(false)
  /// Indywidualny cennik: [{ productId?, sku?, name, netPrice?, discountPercent?, currency }]
  priceListItems         Json?
  priceListValidFrom     String?
  priceListValidTo       String?
  /// Scoring terminowości płatności (wyliczany z historii faktur)
  scoreAvgDelayDays      Float?
  scoreMaxDelayDays      Float?
  scoreOnTimeRatio       Float?    // 0..1
  scorePaymentRating     String?   // excellent | good | average | risky | critical | no_data
  scorePoints            Int?      // 0..100
  scoreUpdatedAt         DateTime?
  /// Metryki 360° (cache — pełne dane liczone w /api/contractors/[id]/crm)
  annualTurnoverNet      Float?    @default(0)
  annualMarginNet        Float?    @default(0)
  annualMarginPercent    Float?    @default(0)
  openReceivables        Float?    @default(0)
  lifetimeTurnoverNet    Float?    @default(0)
  lastInvoiceDate        String?
  statsUpdatedAt         DateTime?

  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([userId])
}

model Product {
  companyId  String?  @db.ObjectId

  @@index([companyId])
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  sku         String?
  unit        String   @default("szt.")
  netPrice    Float    @default(0)
  vatRate     String   @default("23")
  description String?

  // ── Magazyn WMS (sekcja 4) ────────────────────────────────────────────
  /// true = pozycja magazynowa (towar). false = usługa — nie generuje WZ/PZ.
  isStockTracked Boolean @default(false)
  /// Minimalny stan — poniżej tej wartości generowany jest alert niskiego stanu
  minQuantity    Float   @default(0)
  purchasePrice  Float   @default(0)
  gtuCode        String? // domyślny kod GTU dla pozycji (GTU_01 … GTU_13)
  pkwiu          String?
  cnCode         String?
  isSplitPaymentGoods Boolean @default(false) // towar z zał. 15 → MPP
  stockItems     StockItem[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([sku])
}

model CompanyProfile {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  userId         String    @db.ObjectId
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  nip            String
  companyName    String
  invoiceNumberPattern String? // e.g. {PREFIX} {NN}/{MM}/{YYYY}
  street         String?
  buildingNumber String?
  flatNumber     String?
  city           String?
  postalCode     String?
  bankAccount    String?
  ksefToken      String?
  ksefEnvironment String?
  ksefCertFingerprint String?
  ksefCertValidFrom DateTime?
  ksefCertValidTo DateTime?
  ksefCertCheckedAt DateTime?
  isDefault      Boolean   @default(false)
  logoUrl        String?   @default("")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  invoices       Invoice[]
  members        CompanyMember[]
  invitations    TeamInvitation[]
  bankAccounts   CompanyBankAccount[]
  auditLogs      AuditLog[]

  @@unique([userId, nip])
  @@index([userId])
}

/// Reservation makes duplicate numbers impossible under concurrent API requests.
model InvoiceNumberClaim {
  id        String   @id @map("_id")
  invoiceId String?  @db.ObjectId
  createdAt DateTime @default(now())
}

/// Członkostwo i uprawnienia użytkownika w firmie
model CompanyMember {
  id                    String         @id @default(auto()) @map("_id") @db.ObjectId
  companyId             String         @db.ObjectId
  company               CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId                String         @db.ObjectId
  user                  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  role                  String         @default("employee") // "owner" | "accountant" | "employee" | "viewer"
  canIssueInvoices      Boolean        @default(true)
  canCreateCorrections  Boolean        @default(false)
  canRecordPayments     Boolean        @default(false)
  canExport             Boolean        @default(false)
  canSendKsef           Boolean        @default(false)
  canManageBankAccounts Boolean        @default(false)
  canManageTeam         Boolean        @default(false)
  canManageIntegrations Boolean        @default(false)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@unique([companyId, userId])
  @@index([companyId])
  @@index([userId])
}

/// Rachunki bankowe firmy (PLN i walutowe IBAN / SWIFT)
model CompanyBankAccount {
  id                   String         @id @default(auto()) @map("_id") @db.ObjectId
  companyId            String         @db.ObjectId
  company              CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)
  accountName          String         @default("Rachunek główny")
  beneficiaryName      String         @default("")
  currency             String         @default("PLN") // PLN | EUR | USD | GBP | MULTI
  isMultiCurrency      Boolean        @default(false)
  accountNumber        String         // IBAN lub lokalny numer rachunku
  swiftBic             String?        // Kod BIC/SWIFT 8 lub 11 znaków
  bankName             String         @default("")
  bankAddress          String?        @default("")
  transferInstructions String?        @default("")
  isDefault            Boolean        @default(false)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([companyId])
}

/// Faktura
model Invoice {
  issuedAt DateTime?
  costReviewId String? @db.ObjectId
  documentKind String?
  advanceReceivedDate String?
  settlementMetadata Json?
  recurringAnchorDay Int?
  recurringUserId String? @db.ObjectId
  recurringLastAttemptAt DateTime?
  recurringLastError String?
  id              String          @id @default(auto()) @map("_id") @db.ObjectId
  userId          String          @db.ObjectId
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  number          String
  type            String
  status          String          @default("draft")
  contractorId    String
  sellerCompanyId String?         @db.ObjectId
  sellerCompany   CompanyProfile? @relation(fields: [sellerCompanyId], references: [id], onDelete: SetNull)
  issueDate       String
  saleDate        String
  dueDate         String
  currency        String          @default("PLN")
  language        String          @default("PL")
  paymentMethod   String          @default("transfer")
  paymentTermDays Int             @default(14)
  notes           String?
  lines           Json
  ksef            Json?
  nip             String?         @default("")
  totalNet        Float?          @default(0)
  totalVat        Float?          @default(0)
  totalGross      Float?          @default(0)
  ksefNumber      String?
  referenceNumber String?
  upoXml          String?
  ksefXml         String?
  ksefSessionId   String?         @db.ObjectId
  ksefSession     KsefSession?    @relation(fields: [ksefSessionId], references: [id], onDelete: SetNull)
  sentAt          DateTime?
  sentToEmail     String?
  emailStatus     String?
  approvalStatus  String?         @default("pending")
  approvedAt      DateTime?
  approvedBy      String?
  // Rozszerzony cykl życia dokumentu, KSeF i płatności
  documentStatus  String?         @default("draft") // draft | ready | issued | cancelled
  ksefStatus      String?         @default("none")  // none | draft | ready | queued | sending | accepted | rejected | verify_needed
  paymentStatus   String?         @default("unpaid") // unpaid | partially_paid | paid | overdue
  paidAmount      Float?          @default(0)
  version         Int?            @default(1)
  // Obsługa faktur korygujących (KOR)
  isCorrection    Boolean?        @default(false)
  correctionReason String?
  originalInvoiceId String?
  originalInvoiceNumber String?
  originalKsefNumber String?
  originalIssueDate String?
  originalLines   Json?
  // Obsługa trybów offline i kodów QR
  isOffline       Boolean?        @default(false)
  offlineReason   String?
  offlineDeadline DateTime?
  qrCodeI         String?
  qrCodeII        String?
  // Faktury cykliczne
  isRecurring     Boolean?        @default(false)
  recurringInterval String?       // monthly | quarterly | yearly
  recurringNextDate String?
  recurringPaused Boolean?        @default(false)
  recurringAutoSend Boolean?      @default(false)
  // Przypomnienia o płatności
  lastPaymentReminderSentAt DateTime?
  paymentReminderCount      Int?    @default(0)
  // Portal Kontrahenta i Proforma
  shareToken                String?
  isProforma                Boolean? @default(false)
  declaredPaymentDate       String? // Deklarowana data zapłaty przez kontrahenta
  autoSendEmailOnKsef       Boolean? @default(false)

  // Pola walutowe, NBP i bankowe
  exchangeRate              Float?
  exchangeRateUnit          Int?    @default(1)
  exchangeRateDate          String?
  exchangeRateTable         String?
  exchangeRateSource        String?
  exchangeRateRule          String? // art_31a_sale_date | art_31a_issue_date | art_31a_tax_point | manual
  exchangeRateJustification String?
  taxPointDate              String?
  totalNetPln               Float?  @default(0)
  totalVatPln               Float?  @default(0)
  totalGrossPln             Float?  @default(0)
  bankAccountId             String?
  bankAccountSnapshot       Json?
  buyerTaxIdType            String?
  buyerCountry              String?

  // Pola ewidencji JPK_V7M(3) / JPK_V7K(3) — sekcja 3
  gtuCodes                  String[] @default([]) // GTU_01 … GTU_13
  jpkProcedures             String[] @default([]) // WSTO_EE | IED | TP | TT_WNT | TT_D | MR_T | MR_UZ | I_42 | I_63 | B_SPV | B_SPV_DOSTAWA | B_MPV_PROWIZJA
  jpkDocumentType           String?  // RO | WEW | FP (puste = zwykła faktura)
  isSplitPayment            Boolean? @default(false) // MPP — mechanizm podzielonej płatności (art. 108a, zał. 15)
  isWstoEe                  Boolean? @default(false) // WSTO / usługi TBE
  vatRegisterPeriod         String?  // "YYYY-MM" — okres ujęcia w ewidencji VAT

  // Magazyn (sekcja 4) — wygenerowany dokument WZ
  stockDocumentId           String?  @db.ObjectId
  stockDocumentNumber       String?

  // CRM / e-commerce (sekcje 5–6)
  sourceChannel             String?  @default("manual") // manual | api | allegro | woocommerce | shopify | recurring | ocr
  appliedDiscountPercent    Float?   @default(0)

  // Relacje
  payments        PaymentRecord[]
  ksefTasks       KsefQueueTask[]
  comments        DocumentComment[]
  emailLogs       InvoiceEmailLog[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([userId])
  @@index([sellerCompanyId])
  @@index([referenceNumber])
  @@index([ksefNumber])
  @@index([ksefStatus])
  @@index([paymentStatus])
  @@index([shareToken])
  @@index([sellerCompanyId, issuedAt])
  @@index([userId, issuedAt])
}

model Notification {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String   @default("system")
  title     String
  body      String?
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

model NotificationPreference {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  userId         String   @unique @db.ObjectId
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  browserEnabled Boolean  @default(false)
  soundEnabled   Boolean  @default(true)
  updatedAt      DateTime @updatedAt
}

model PasswordResetToken {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  userId    String    @db.ObjectId
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model PaymentRecord {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  invoiceId String   @db.ObjectId
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Float
  paidAt    DateTime @default(now())
  method    String   @default("transfer")
  note      String?
  createdAt DateTime @default(now())

  @@index([invoiceId])
  @@index([userId])
}

model KsefQueueTask {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  userId         String    @db.ObjectId
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoiceId      String    @db.ObjectId
  invoice        Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  environment    String    @default("test")
  status         String    @default("queued") // queued | processing | completed | failed | verify_needed
  attempts       Int       @default(0)
  maxAttempts    Int       @default(5)
  lastAttemptAt  DateTime?
  nextAttemptAt  DateTime?
  lockedUntil    DateTime?
  errorDetails   String?
  idempotencyKey String    @unique
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, nextAttemptAt])
  @@index([userId])
  @@index([invoiceId])
}

model AuditLog {
  id          String          @id @default(auto()) @map("_id") @db.ObjectId
  companyId   String?         @db.ObjectId
  company     CompanyProfile? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  documentId  String?
  userId      String?         @db.ObjectId
  user        User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName    String?         // snapshot wykonawcy np. "Anna Kowalska" lub "System"
  userEmail   String?
  action      String          // e.g. "invoice_create", "invoice_update", "invoice_issue", "payment_add", "team_invite"
  entityType  String          // "invoice", "payment", "company", "bank_account", "team"
  entityId    String
  description String?         // np. "Anna Kowalska zmieniła termin płatności z 20.09.2026 na 27.09.2026"
  diff        Json?           // { field: { old, new, label } }
  details     Json?           // bezpieczne metadane (bez haseł/kluczy)
  createdAt   DateTime        @default(now())

  @@index([companyId, createdAt])
  @@index([documentId, createdAt])
  @@index([userId, createdAt])
  @@index([action])
}

model Offer {
  companyId String? @db.ObjectId
  @@index([companyId, createdAt])
  id               String            @id @default(auto()) @map("_id") @db.ObjectId
  userId           String            @db.ObjectId
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  number           String
  contractorId     String?
  contractorName   String
  contractorNip    String?
  title            String            @default("Oferta handlowa")
  status           String            @default("draft") // draft | sent | accepted | rejected | expired | converted
  issueDate        String
  validUntil       String
  currency         String            @default("PLN")
  lines            Json              // pozycje oferty
  totalNet         Float             @default(0)
  totalVat         Float             @default(0)
  totalGross       Float             @default(0)
  notes            String?
  publicToken      String            @unique
  version          Int               @default(1)
  acceptedAt       DateTime?
  rejectionReason  String?
  convertedOrderId String?           @db.ObjectId
  orders           Order[]
  comments         DocumentComment[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([userId])
  @@index([status])
}

model Order {
  companyId String? @db.ObjectId
  @@index([companyId, createdAt])
  id              String          @id @default(auto()) @map("_id") @db.ObjectId
  userId          String          @db.ObjectId
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  number          String
  offerId         String?         @db.ObjectId
  offer           Offer?          @relation(fields: [offerId], references: [id], onDelete: SetNull)
  contractorId    String?
  contractorName  String
  title           String
  status          String          @default("in_progress") // in_progress | completed | billed | cancelled
  stages          Json?           // Etapy: [{ id, name, amount, status, dueDate, billedInvoiceId }]
  hourlyRate      Float?          @default(0)
  trackedMinutes  Int             @default(0)
  totalNet        Float           @default(0)
  totalGross      Float           @default(0)
  currency        String          @default("PLN")
