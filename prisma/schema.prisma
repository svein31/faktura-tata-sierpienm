model Warehouse {
  currency String? // Explicit only for newly configured stock; never infer legacy currency.
  /// Transaction serialization token; no business meaning, safe for legacy records.
  operationKey String?
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String? @db.ObjectId

  name      String
  code      String  @default("MAG")
  address   Json?
  isDefault Boolean @default(false)
  isActive  Boolean @default(true)
  notes     String?

  stockItems     StockItem[]
  stockDocuments StockDocument[]
  stockMovements StockMovement[]
  stocktakings   Stocktaking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, code])
  @@index([userId])
}

/// Exactly-once command receipt, committed in the same transaction as business changes.
model WorkspaceCommand {
  id String @id @map("_id") @db.ObjectId
  userId String @db.ObjectId
  companyId String @db.ObjectId
  action String
  payloadHash String
  result Json
  createdAt DateTime @default(now())
  @@index([companyId, createdAt])
