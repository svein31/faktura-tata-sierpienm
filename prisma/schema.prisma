// ════════════════════════════════════════════════════════════════════════
// SEKCJA 3 — PODATKI / ZUS REAL-TIME + JPK
// ════════════════════════════════════════════════════════════════════════

/// Profil podatkowy firmy — forma opodatkowania, ZUS, VAT, dane do JPK
model TaxProfile {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @unique @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String? @db.ObjectId

  /// "ryczalt" | "liniowy" | "skala"
  taxationForm        String  @default("skala")
  /// Stawka ryczałtu w % — 8.5 | 12 | 15 (pełny katalog: 2, 3, 5.5, 8.5, 10, 12, 14, 15, 17)
  ryczaltRate         Float?  @default(8.5)
  /// Dodatkowa stawka 12.5% od nadwyżki ponad 100 000 zł (art. 12 ust. 1 pkt 4 — najem)
  ryczaltSurchargeEnabled Boolean @default(false)

  // ── VAT ──
  vatPayer            Boolean @default(true)
  /// "monthly" → JPK_V7M | "quarterly" → JPK_V7K
  vatPeriod           String  @default("monthly")
  /// Kod urzędu skarbowego (4 znaki, np. "1471") — wymagany w nagłówku JPK
  taxOfficeCode       String  @default("")
  /// Dane do Podmiot1 w JPK
  jpkEntityType       String  @default("nonPhysical") // nonPhysical | physical
  jpkFirstName        String?
  jpkLastName         String?
  jpkBirthDate        String?
  jpkEmail            String  @default("")
  jpkPhone            String?

  // ── ZUS ──
  /// "full" (duży ZUS) | "preferential" (30% min. wynagr., 24 mies.) | "ulga_na_start" | "maly_zus_plus" | "none"
  zusScheme           String  @default("full")
  /// Dobrowolne ubezpieczenie chorobowe (2,45%)
  zusSickness         Boolean @default(true)
  /// Fundusz Pracy i FS (2,45%) — zwolnienie: K 55+/M 60+ lub podstawa < min. wynagrodzenia
  zusLabourFund       Boolean @default(true)
  /// Stopa wypadkowa w % (standard 1,67% dla ≤ 9 ubezpieczonych)
  zusAccidentRate     Float   @default(1.67)
  /// Podstawa dla Małego ZUS Plus (ustalana indywidualnie)
  zusCustomSocialBase Float?
  /// Wakacje składkowe — miesiąc (1..12), w którym składki społeczne finansuje budżet
  zusHolidayMonth     Int?
  /// Składki społeczne w KUP (true) albo odliczane od dochodu (false)
  socialInCosts       Boolean @default(false)

  // ── PIT ──
  /// "monthly" | "quarterly" (mali podatnicy / rozpoczynający działalność)
  pitAdvancePeriod    String  @default("monthly")
  /// Stosowanie kwoty zmniejszającej podatek (3 600 zł/rok) — tylko skala
  applyTaxReducingAmount Boolean @default(true)
  /// Strata z lat poprzednich do odliczenia
  lossCarryForward    Float   @default(0)
  /// Nadpłata / zaliczki wpłacone od początku roku (narastająco)
  paidAdvancesYtd     Float   @default(0)

  // ── Biała Lista VAT ──
  /// Próg weryfikacji w PLN — art. 19 Prawa przedsiębiorców (domyślnie 15 000)
  whitelistThreshold  Float   @default(15000)
  whitelistAutoCheck  Boolean @default(true)

  /// Nadpisania parametrów rocznych: { "2026": { minWage, averageWage, … } }
  parameterOverrides  Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Migawka rozliczenia podatkowo-ZUS-owego za okres (miesiąc / kwartał)
model TaxSettlement {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  periodYear  Int
  periodMonth Int // 1..12 (dla kwartału — ostatni miesiąc okresu)
  periodLabel String // np. "2026-03"

  taxationForm String
  ryczaltRate  Float?

  // Podstawy
  revenueNet  Float @default(0) // przychód netto (FV sprzedaż)
  costsNet    Float @default(0) // koszty netto (wydatki)
  incomeBase  Float @default(0) // dochód = FV − koszty
  revenueYtd  Float @default(0)
  costsYtd    Float @default(0)
  incomeYtd   Float @default(0)

  // ZUS
  zusSocialBase   Float @default(0)
  zusPension      Float @default(0) // emerytalna 19,52%
  zusDisability   Float @default(0) // rentowa 8,00%
  zusSickness     Float @default(0) // chorobowa 2,45%
  zusAccident     Float @default(0) // wypadkowa 1,67%
  zusLabourFund   Float @default(0) // FP + FS 2,45%
  zusSocialTotal  Float @default(0)
  zusHealthBase   Float @default(0)
  zusHealth       Float @default(0) // składka zdrowotna
  zusTotal        Float @default(0)

  // PIT
  pitBase         Float @default(0)
  pitRateApplied  Float @default(0)
  pitTaxYtd       Float @default(0)
  pitAdvance      Float @default(0) // zaliczka do zapłaty za okres
  pitAdvanceRounded Float @default(0) // zaokrąglona do pełnych złotych
  pitDeferred     Boolean @default(false) // nie przekroczono progu 1 000 zł

  // VAT
  vatDue          Float @default(0) // P_51
  vatToCarry      Float @default(0) // P_62

  totalDue        Float @default(0) // ZUS + PIT + VAT
  /// Termin płatności — 20. dzień miesiąca następującego po okresie ("YYYY-MM-20")
  dueDate         String
  daysLeft        Int   @default(0)

  breakdown Json? // pełny ślad obliczeniowy (kroki + podstawy prawne)
  paid      Boolean   @default(false)
  paidAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, periodLabel])
  @@index([userId, periodYear])
}

/// Wygenerowany plik JPK (V7M / V7K / FA)
model JpkExport {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  userId    String  @db.ObjectId
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String? @db.ObjectId

  /// "JPK_V7M" | "JPK_V7K" | "JPK_FA"
  kind           String
  /// kodSystemowy, np. "JPK_V7M (3)" | "JPK_V7K (3)" | "JPK_FA (4)"
  systemCode     String
  schemaVersion  String // wersjaSchemy, np. "1-0E"
  variant        String // WariantFormularza, np. "3" | "4"
  namespaceUri   String

  periodYear    Int
  periodMonth   Int?
  periodQuarter Int?
  periodFrom    String? // JPK_FA — DataOd
  periodTo      String? // JPK_FA — DataDo
  /// CelZlozenia: 1 = złożenie pierwotne, 2 = korekta
  purpose       Int     @default(1)
  correctionReason String?

  fileName  String
  xml       String
  sizeBytes Int    @default(0)
  checksum  String // SHA-256 pliku — dowód integralności

  invoiceCount Int   @default(0)
  expenseCount Int   @default(0)
  totalNet     Float @default(0)
  totalVat     Float @default(0)
  totalGross   Float @default(0)
  outputVat    Float @default(0) // PodatekNalezny
  inputVat     Float @default(0) // PodatekNaliczony
  vatDue       Float @default(0) // P_51

  gtuSummary       Json? // { "GTU_01": 3, … }
  procedureSummary Json? // { "WSTO_EE": 1, "TP": 2, … }
  validationIssues Json? // [{ level, code, message, row? }]
  isValid          Boolean @default(true)

  createdAt DateTime @default(now())

  @@index([userId, kind, periodYear])
  @@index([checksum])
}

/// Dowód weryfikacji rachunku w Wykazie podatników VAT (Biała Lista, wl-api.mf.gov.pl)
/// Retencja: min. 5 lat (art. 70 § 1 Ordynacji podatkowej) — dowód należytej staranności.
model WhitelistCheck {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  nip           String
  accountNumber String // NRB 26 cyfr, bez "PL" i spacji
  /// Data, na którą weryfikowano (parametr `date`, YYYY-MM-DD) — dzień zlecenia przelewu
  checkDate     String
  /// Kwota płatności, która wywołała weryfikację
  amount        Float?
  currency      String  @default("PLN")
  /// Próg obowiązujący w momencie weryfikacji (domyślnie 15 000 PLN)
  threshold     Float   @default(15000)
  thresholdExceeded Boolean @default(true)

  /// "check" | "search"
  endpoint      String  @default("check")
  /// "assigned" | "not_assigned" | "not_found" | "virtual_account" | "error"
  result        String
  /// Surowa wartosć z API: "TAK" | "NIE"
  accountAssigned String?
  /// "Czynny" | "Zwolniony" | "Niezarejestrowany"
  subjectStatus String?
  subjectName   String?
  hasVirtualAccounts Boolean @default(false)
  /// Unikalny identyfikator zapytania MF — dowód przed organem podatkowym
  requestId     String?
  /// requestDateTime z API (format dd-MM-yyyy HH:mm:ss, konwertowany na ISO)
  requestDateTime DateTime?

  invoiceId String? @db.ObjectId
  expenseId String? @db.ObjectId
  bankTransactionId String? @db.ObjectId

  /// Zawiadomienie ZAW-NR złożone (wyłączenie odpowiedzialności, art. 117ba § 3 pkt 1 OP)
  zawNrFiled   Boolean   @default(false)
  zawNrFiledAt DateTime?

  errorCode    String? // np. WL-101
  errorMessage String?
  rawResponse  Json?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([nip, accountNumber, checkDate])
  @@index([requestId])
}

