// ─────────────────────────────────────────────────────────────────────────────
// Fakturo — schema Prisma (MongoDB Atlas)
//
// DATABASE_URL="mongodb+srv://<username>:<password>@cluster.mongodb.net/fakturo?retryWrites=true&w=majority"
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id                  String                  @id @default(auto()) @map("_id") @db.ObjectId
  email               String                  @unique
  password            String // Zawsze zhashowane bcrypt (12 rund)
  name                String?                 @default("")
  nip                 String?                 @default("")
  companyName         String?                 @default("")
  role                String                  @default("owner") // "owner" | "accountant" | "viewer"
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  sessions            Session[]
  resetTokens         PasswordResetToken[]
  auditLogs           AuditLog[]
  paymentRecords      PaymentRecord[]
  ksefTasks           KsefQueueTask[]
  company             CompanySettings?
  companyProfiles     CompanyProfile[]
  ksef                KsefSettings?
  contractors         Contractor[]
  products            Product[]
  invoices            Invoice[]
  ksefSessions        KsefSession[]
  incomingKsefImports KsefIncomingImport[]
  notifications       Notification[]
  preferences         NotificationPreference?
  offers              Offer[]
  orders              Order[]
  expenses            Expense[]
  bankImports         BankStatementImport[]
  comments            DocumentComment[]
  sentInvitations     TeamInvitation[]
  invoiceEmailLogs    InvoiceEmailLog[]
  companyMemberships  CompanyMember[]
  termsAcceptedAt     DateTime?
  termsAcceptedVersion String?
  legalConsents       LegalConsent[]
}

/// Trwała sesja użytkownika powiązana z bazą danych
model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

model CompanySettings {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @unique @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String   @default("")
  nip       String   @default("")
  regon     String   @default("")
  street    String   @default("")
  city      String   @default("")
  postal    String   @default("")
  country   String   @default("PL")
  iban      String   @default("")
  bankName  String   @default("")
  email     String   @default("")
  phone     String   @default("")
  logoUrl   String?  @default("")
  updatedAt DateTime @updatedAt
}

/// Ustawienia KSeF
model KsefSettings {
  id                 String    @id @default(auto()) @map("_id") @db.ObjectId
  userId             String    @unique @db.ObjectId
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  environment        String    @default("demo")
  tokenSet           Boolean   @default(false)
  tokenMask          String    @default("")
  certName           String    @default("")
  autoValidate          Boolean   @default(true)
  lastIncomingSyncAt    DateTime?
  autoSyncEnabled       Boolean   @default(false)
  autoSyncIntervalHours Int       @default(1)
  autoSyncNotifyEmail   String?   @default("")
  lastAutoSyncAt        DateTime?
  updatedAt             DateTime  @updatedAt
}

/// Sesja uwierzytelniona KSeF API 2.0
model KsefSession {
  id                  String    @id @default(auto()) @map("_id") @db.ObjectId
  userId              String?   @db.ObjectId
  user                User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nip                 String
  environment         String    @default("test")
  referenceNumber     String    @unique
  authenticationToken String?
  accessToken         String?
  refreshToken        String?
  validUntil          DateTime?
  status              String    @default("ACTIVE")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  invoices            Invoice[]

  @@index([nip])
  @@index([userId])
}

model KsefIncomingImport {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  userId              String   @db.ObjectId
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ksefReferenceNumber String   @unique
  invoiceId           String?  @db.ObjectId
  createdAt           DateTime @default(now())

  @@index([userId])
}

model Contractor {
  companyId  String?  @db.ObjectId

  @@index([companyId])
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String   @db.ObjectId
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  nip        String
  regon      String?
  address    Json
  email      String?
  phone      String?
  iban       String?
  bankName   String?
  isVatPayer             Boolean   @default(true)
  notes                  String?
  tags                   String[]  @default([])
  defaultCurrency        String?   @default("PLN")
  defaultPaymentTermDays Int?      @default(14)
  defaultDiscountPercent Float?    @default(0)
  contacts               Json?     // Lista osób kontaktowych: [{ name, email, phone, role }]
  vatStatus              String?   // "czynny" | "zwolniony" | "nieznany"
  vatCheckedAt           DateTime?
  vatCheckSource         String?   // "mf_whitelist" | "gus_bir" | "manual"
  taxIdType              String?   @default("nip") // "nip" | "vat_eu" | "tin" | "other" | "none"
  taxId                  String?   // Pełny identyfikator zachowujący litery, separatory i zera wiodące
  country                String?   @default("PL")
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([userId])
}

model Product {
  companyId  String?  @db.ObjectId

  @@index([companyId])
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  sku         String?
  unit        String   @default("szt.")
  netPrice    Float    @default(0)
  vatRate     String   @default("23")
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model CompanyProfile {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  userId         String    @db.ObjectId
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  nip            String
  companyName    String
  street         String?
  buildingNumber String?
  flatNumber     String?
  city           String?
  postalCode     String?
  bankAccount    String?
  ksefToken      String?
  isDefault      Boolean   @default(false)
  logoUrl        String?   @default("")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  invoices       Invoice[]
  members        CompanyMember[]
  invitations    TeamInvitation[]
  bankAccounts   CompanyBankAccount[]
  auditLogs      AuditLog[]

  @@unique([userId, nip])
  @@index([userId])
}

/// Członkostwo i uprawnienia użytkownika w firmie
model CompanyMember {
  id                    String         @id @default(auto()) @map("_id") @db.ObjectId
  companyId             String         @db.ObjectId
  company               CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId                String         @db.ObjectId
  user                  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  role                  String         @default("employee") // "owner" | "accountant" | "employee" | "viewer"
  canIssueInvoices      Boolean        @default(true)
  canCreateCorrections  Boolean        @default(false)
  canRecordPayments     Boolean        @default(false)
  canExport             Boolean        @default(false)
  canSendKsef           Boolean        @default(false)
  canManageBankAccounts Boolean        @default(false)
  canManageTeam         Boolean        @default(false)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@unique([companyId, userId])
  @@index([companyId])
  @@index([userId])
}

/// Rachunki bankowe firmy (PLN i walutowe IBAN / SWIFT)
model CompanyBankAccount {
  id                   String         @id @default(auto()) @map("_id") @db.ObjectId
  companyId            String         @db.ObjectId
  company              CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)
  accountName          String         @default("Rachunek główny")
  beneficiaryName      String         @default("")
  currency             String         @default("PLN") // PLN | EUR | USD | GBP | MULTI
  isMultiCurrency      Boolean        @default(false)
  accountNumber        String         // IBAN lub lokalny numer rachunku
  swiftBic             String?        // Kod BIC/SWIFT 8 lub 11 znaków
  bankName             String         @default("")
  bankAddress          String?        @default("")
  transferInstructions String?        @default("")
  isDefault            Boolean        @default(false)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([companyId])
}

/// Faktura
model Invoice {
  id              String          @id @default(auto()) @map("_id") @db.ObjectId
  userId          String          @db.ObjectId
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  number          String
  type            String
  status          String          @default("draft")
  contractorId    String
  sellerCompanyId String?         @db.ObjectId
  sellerCompany   CompanyProfile? @relation(fields: [sellerCompanyId], references: [id], onDelete: SetNull)
  issueDate       String
  saleDate        String
  dueDate         String
  currency        String          @default("PLN")
  language        String          @default("PL")
  paymentMethod   String          @default("transfer")
  paymentTermDays Int             @default(14)
  notes           String?
  lines           Json
  ksef            Json?
  nip             String?         @default("")
  totalNet        Float?          @default(0)
  totalVat        Float?          @default(0)
  totalGross      Float?          @default(0)
  ksefNumber      String?
  referenceNumber String?
  upoXml          String?
  ksefXml         String?
  ksefSessionId   String?         @db.ObjectId
  ksefSession     KsefSession?    @relation(fields: [ksefSessionId], references: [id], onDelete: SetNull)
  sentAt          DateTime?
  sentToEmail     String?
  emailStatus     String?
  approvalStatus  String?         @default("pending")
  approvedAt      DateTime?
  approvedBy      String?
  // Rozszerzony cykl życia dokumentu, KSeF i płatności
  documentStatus  String?         @default("draft") // draft | ready | issued | cancelled
  ksefStatus      String?         @default("none")  // none | draft | ready | queued | sending | accepted | rejected | verify_needed
  paymentStatus   String?         @default("unpaid") // unpaid | partially_paid | paid | overdue
  paidAmount      Float?          @default(0)
  version         Int?            @default(1)
  // Obsługa faktur korygujących (KOR)
  isCorrection    Boolean?        @default(false)
  correctionReason String?
  originalInvoiceId String?
  originalInvoiceNumber String?
  originalKsefNumber String?
  originalIssueDate String?
  originalLines   Json?
  // Obsługa trybów offline i kodów QR
  isOffline       Boolean?        @default(false)
  offlineReason   String?
  offlineDeadline DateTime?
  qrCodeI         String?
  qrCodeII        String?
  // Faktury cykliczne
  isRecurring     Boolean?        @default(false)
  recurringInterval String?       // monthly | quarterly | yearly
  recurringNextDate String?
  recurringPaused Boolean?        @default(false)
  recurringAutoSend Boolean?      @default(false)
  // Przypomnienia o płatności
  lastPaymentReminderSentAt DateTime?
  paymentReminderCount      Int?    @default(0)
  // Portal Kontrahenta i Proforma
  shareToken                String?
  isProforma                Boolean? @default(false)
  declaredPaymentDate       String? // Deklarowana data zapłaty przez kontrahenta
  autoSendEmailOnKsef       Boolean? @default(false)

  // Pola walutowe, NBP i bankowe
  exchangeRate              Float?
  exchangeRateUnit          Int?    @default(1)
  exchangeRateDate          String?
  exchangeRateTable         String?
  exchangeRateSource        String?
  exchangeRateRule          String? // art_31a_sale_date | art_31a_issue_date | art_31a_tax_point | manual
  exchangeRateJustification String?
  taxPointDate              String?
  totalNetPln               Float?  @default(0)
  totalVatPln               Float?  @default(0)
  totalGrossPln             Float?  @default(0)
  bankAccountId             String?
  bankAccountSnapshot       Json?
  buyerTaxIdType            String?
  buyerCountry              String?

  // Relacje
  payments        PaymentRecord[]
  ksefTasks       KsefQueueTask[]
  comments        DocumentComment[]
  emailLogs       InvoiceEmailLog[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([userId])
  @@index([sellerCompanyId])
  @@index([referenceNumber])
  @@index([ksefNumber])
  @@index([ksefStatus])
  @@index([paymentStatus])
  @@index([shareToken])
}

model Notification {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String   @default("system")
  title     String
  body      String?
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

model NotificationPreference {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  userId         String   @unique @db.ObjectId
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  browserEnabled Boolean  @default(false)
  soundEnabled   Boolean  @default(true)
  updatedAt      DateTime @updatedAt
}

model PasswordResetToken {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  userId    String    @db.ObjectId
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model PaymentRecord {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  invoiceId String   @db.ObjectId
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Float
  paidAt    DateTime @default(now())
  method    String   @default("transfer")
  note      String?
  createdAt DateTime @default(now())

  @@index([invoiceId])
  @@index([userId])
}

model KsefQueueTask {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  userId         String    @db.ObjectId
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoiceId      String    @db.ObjectId
  invoice        Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  environment    String    @default("test")
  status         String    @default("queued") // queued | processing | completed | failed | verify_needed
  attempts       Int       @default(0)
  maxAttempts    Int       @default(5)
  lastAttemptAt  DateTime?
  nextAttemptAt  DateTime?
  lockedUntil    DateTime?
  errorDetails   String?
  idempotencyKey String    @unique
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, nextAttemptAt])
  @@index([userId])
  @@index([invoiceId])
}

model AuditLog {
  id          String          @id @default(auto()) @map("_id") @db.ObjectId
  companyId   String?         @db.ObjectId
  company     CompanyProfile? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  documentId  String?
  userId      String?         @db.ObjectId
  user        User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName    String?         // snapshot wykonawcy np. "Anna Kowalska" lub "System"
  userEmail   String?
  action      String          // e.g. "invoice_create", "invoice_update", "invoice_issue", "payment_add", "team_invite"
  entityType  String          // "invoice", "payment", "company", "bank_account", "team"
  entityId    String
  description String?         // np. "Anna Kowalska zmieniła termin płatności z 20.09.2026 na 27.09.2026"
  diff        Json?           // { field: { old, new, label } }
  details     Json?           // bezpieczne metadane (bez haseł/kluczy)
  createdAt   DateTime        @default(now())

  @@index([companyId, createdAt])
  @@index([documentId, createdAt])
  @@index([userId, createdAt])
  @@index([action])
}

model Offer {
  id               String            @id @default(auto()) @map("_id") @db.ObjectId
  userId           String            @db.ObjectId
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  number           String
  contractorId     String?
  contractorName   String
  contractorNip    String?
  title            String            @default("Oferta handlowa")
  status           String            @default("draft") // draft | sent | accepted | rejected | expired | converted
  issueDate        String
  validUntil       String
  currency         String            @default("PLN")
  lines            Json              // pozycje oferty
  totalNet         Float             @default(0)
  totalVat         Float             @default(0)
  totalGross       Float             @default(0)
  notes            String?
  publicToken      String            @unique
  version          Int               @default(1)
  acceptedAt       DateTime?
  rejectionReason  String?
  convertedOrderId String?           @db.ObjectId
  orders           Order[]
  comments         DocumentComment[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([userId])
  @@index([status])
}

model Order {
  id              String          @id @default(auto()) @map("_id") @db.ObjectId
  userId          String          @db.ObjectId
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  number          String
  offerId         String?         @db.ObjectId
  offer           Offer?          @relation(fields: [offerId], references: [id], onDelete: SetNull)
  contractorId    String?
  contractorName  String
  title           String
  status          String          @default("in_progress") // in_progress | completed | billed | cancelled
  stages          Json?           // Etapy: [{ id, name, amount, status, dueDate, billedInvoiceId }]
  hourlyRate      Float?          @default(0)
  trackedMinutes  Int             @default(0)
  totalNet        Float           @default(0)
  totalGross      Float           @default(0)
  currency        String          @default("PLN")
  notes           String?
  billedInvoiceId String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([userId])
  @@index([status])
}

model Expense {
  id             String            @id @default(auto()) @map("_id") @db.ObjectId
  userId         String            @db.ObjectId
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  number         String
  contractorName String
  nip            String?
  issueDate      String
  dueDate        String?
  category       String            @default("inne") // biuro | sprzęt | paliwo | oprogramowanie | marketing | usługi | podatki | inne
  description    String?
  totalNet       Float             @default(0)
  totalVat       Float             @default(0)
  totalGross     Float             @default(0)
  currency       String            @default("PLN")
  paymentStatus  String            @default("unpaid") // unpaid | paid
  paidAt         DateTime?
  attachmentUrl  String?
  attachmentName String?
  workflowStatus String            @default("to_verify") // to_verify | verified | sent_to_accountant
  isKsefSource   Boolean           @default(false)
  ksefRefNumber  String?
  comments       DocumentComment[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([userId])
  @@index([category])
  @@index([workflowStatus])
  @@index([issueDate])
}

model BankStatementImport {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  userId       String   @db.ObjectId
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  filename     String
  bankFormat   String   // mbank | pko | santander | ing | alior | millennium | generic
  rowCount     Int
  matchedCount Int      @default(0)
  totalAmount  Float    @default(0)
  fileHash     String   @unique
  importedAt   DateTime @default(now())

  @@index([userId])
}

model DocumentComment {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String   @db.ObjectId
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  authorName String
  authorRole String   // owner | accountant | employee | client
  docType    String   // invoice | offer | expense
  docId      String
  invoice    Invoice? @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId  String?  @db.ObjectId
  offer      Offer?   @relation(fields: [offerId], references: [id], onDelete: Cascade)
  offerId    String?  @db.ObjectId
  expense    Expense? @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  expenseId  String?  @db.ObjectId
  message    String
  createdAt  DateTime @default(now())

  @@index([docType, docId])
  @@index([userId])
}

model TeamInvitation {
  id         String          @id @default(auto()) @map("_id") @db.ObjectId
  companyId  String?         @db.ObjectId
  company    CompanyProfile? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId     String          @db.ObjectId
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  email      String
  role       String          @default("accountant") // owner | accountant | employee | viewer
  permissions Json?          // opcjonalne granularne uprawnienia
  token      String          @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  status     String          @default("pending") // pending | accepted | revoked | expired
  createdAt  DateTime        @default(now())

  @@index([userId])
  @@index([companyId])
  @@index([email])
}

model InvoiceEmailLog {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  invoiceId   String   @db.ObjectId
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  userId      String   @db.ObjectId
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  to          String
  cc          String?
  bcc         String?
  subject     String
  messageBody String?
  attachments Json?    // [{ filename: string, size?: number, contentType?: string }]
  status      String   @default("sent") // "queued" | "accepted" | "sent" | "delivered" | "failed"
  provider    String   // "smtp" | "resend"
  messageId   String?
  error       String?
  sentAt      DateTime @default(now())

  @@index([invoiceId])
  @@index([userId])
}

/// Rejestr akceptacji dokumentów prawnych i zgód użytkowników
model LegalConsent {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  userId          String    @db.ObjectId
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentType    String    // "terms_of_service" | "privacy_policy" | "dpa" | "marketing_email" | "cookie_functional" | "cookie_analytics" | "cookie_marketing"
  documentVersion String    // np. "1.0.0-2026-09-13"
  accepted        Boolean   @default(true)
  acceptedAt      DateTime  @default(now())
  revokedAt       DateTime?
  ipAddress       String?   // zanonimizowane IP np. 192.168.1.0/24
  userAgent       String?
  context         String?   // "registration" | "invite_accept" | "terms_update_modal" | "settings"
  companyId       String?

  @@index([userId, documentType])
  @@index([documentType, documentVersion])
}




